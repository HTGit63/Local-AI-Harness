# Gemma 4 Harness local runtime

# Primary runtime: llama.cpp OpenAI-compatible server
HARNESS_RUNTIME_PROVIDER=llamacpp
HARNESS_PRIMARY_RUNTIME=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL_PATH=models/<local-model-file>.gguf
LLAMACPP_MODEL_ALIAS=gemma4:e4b
OPENAI_API_KEY=no-key

# Fallback runtime: Ollama legacy, visible only when primary is unavailable
HARNESS_ENABLE_OLLAMA_FALLBACK=1
HARNESS_FALLBACK_RUNTIME=ollama-legacy
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b

# Local model budget
HARNESS_LOCAL_MODEL_BUDGET_PROFILE=balanced
HARNESS_CONTEXT_BUDGET=16000
