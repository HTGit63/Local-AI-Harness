# Gemma 4 Harness local runtime

# Default runtime: Ollama legacy. llama.cpp/GGUF stays available from settings.
HARNESS_RUNTIME_PROVIDER=ollama-legacy
HARNESS_PRIMARY_RUNTIME=ollama-legacy
HARNESS_MODEL=gemma4:e4b-it-qat
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b-it-qat
OPENAI_API_KEY=ollama

# Optional GGUF runtime
HARNESS_ENABLE_OLLAMA_FALLBACK=1
HARNESS_FALLBACK_RUNTIME=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL_PATH=models/<local-model-file>.gguf
LLAMACPP_MODEL_ALIAS=gemma-4-gguf

# Local model budget
HARNESS_LOCAL_MODEL_BUDGET_PROFILE=balanced
HARNESS_CONTEXT_BUDGET=16000

# Durable run logs: off | summary | full
HARNESS_LOG_PROMPTS=summary
